  "main": "src/index.ts",
  "scripts": {
    "start": "node --env-file .env --experimental-strip-types src/index.ts",
    "dev": "node --no-warnings --env-file .env --watch --experimental-strip-types src/index.ts",
    "typecheck": "tsc --noEmit",
