    "@langchain/ollama": "^0.2.4",
    "@langchain/openai": "^0.4.2",
    "langchain": "^0.3.37",
    "neo4j-driver": "^5.28.0",
    "oracledb": "^6.10.0",
    "pdf-parse": "^1.1.1",
    "zod": "^3.25.76"
