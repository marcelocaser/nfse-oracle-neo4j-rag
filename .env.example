# Neo4j — valores padrão do docker-compose.yml deste exemplo (npm run infra:up)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Ollama — https://docs.ollama.com
# Servidor local (o instalador do Linux já sobe como serviço na porta 11434)
OLLAMA_HOST=http://localhost:11434

# Modelo de embeddings, rodado localmente pelo Ollama:
#   ollama pull embeddinggemma
# Trocar de modelo muda a dimensão dos vetores: rode `npm run clean` antes.
EMBEDDING_MODEL=embeddinggemma

# LLM via API compatível com OpenAI do Ollama. Modelos ":cloud" rodam na nuvem
# do Ollama através do servidor local — faça `ollama signin` uma vez.
# gemma4:cloud está incluído no plano gratuito.
NLP_MODEL=gemma4:cloud
LLM_BASE_URL=http://localhost:11434/v1
# Modelos locais com "thinking" (gemma4) gastam a resposta pensando: use "none".
LLM_REASONING_EFFORT=

# OCR local para PDFs sem camada de texto (escaneados/fotografados):
#   ollama pull glm-ocr        e        sudo apt-get install -y poppler-utils
OCR_ENABLED=true
OCR_MODEL=glm-ocr
# 100 dpi ≈ 30 s/página numa GPU de 4 GB; suba (ex.: 150) se errar campos.
# Vale para uma A4: páginas maiores (fotos) são reduzidas ao mesmo tamanho.
OCR_DPI=100

# Grafo das NFS-e: na ingestão o LLM extrai os campos de cada nota (validados
# contra o texto) e grava (Empresa)-[:PRESTOU]->(Nota). Perguntas sobre o
# conjunto ("quais notas têm ISS retido?") viram Cypher sobre todas as notas.
# ~10 s por documento com o LLM local. "false" volta ao RAG só com trechos.
EXTRACTION_ENABLED=true
# Busca nos trechos: "hybrid" (vetor + palavra-chave) ou "vector".
SEARCH_TYPE=hybrid
# Só necessário para chamar a nuvem direto (LLM_BASE_URL=https://ollama.com/v1).
# Crie em https://ollama.com/settings/keys — nunca versione a chave.
OLLAMA_API_KEY=

# ---------------------------------------------------------------------------
# Oracle 11g — origem dos PDFs (coluna BLOB)
#
# Exige Thick mode com Oracle Instant Client 19.x: o Thin mode do node-oracledb
# só conecta em Oracle Database 12.1+. Veja o README para a instalação.
# ---------------------------------------------------------------------------
ORACLE_USER=
ORACLE_PASSWORD=

# Easy Connect (exige SERVICE_NAME):  host:1521/orclpdb
# Em 11g que só expõe SID, use o descritor TNS completo:
#   (DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=meu-host)(PORT=1521))(CONNECT_DATA=(SID=orcl)))
ORACLE_CONNECT_STRING=

# Só tem efeito em Windows/macOS. No Linux registre as libs via ldconfig (README).
ORACLE_CLIENT_LIB_DIR=
# Pasta com tnsnames.ora / sqlnet.ora, se você usar um alias TNS acima
ORACLE_TNS_ADMIN=

# Tabela e colunas de onde os PDFs são lidos
ORACLE_PDF_TABLE=DOCUMENTOS
ORACLE_PDF_ID_COLUMN=ID
ORACLE_PDF_NAME_COLUMN=NOME
ORACLE_PDF_BLOB_COLUMN=ARQUIVO

# Opcional: sobrescreve a query inteira (para joins/filtros próprios).
# Contrato: retornar as colunas ID, NAME e DATA e usar o bind :maxDocs.
# Ex.: SELECT d.ID AS ID, d.NOME AS NAME, d.ARQUIVO AS DATA FROM DOCUMENTOS d
#        WHERE d.CATEGORIA = 'TENSORES' AND ROWNUM <= :maxDocs
ORACLE_PDF_QUERY=

# Quantos PDFs ingerir por execução
ORACLE_PDF_MAX_DOCS=10

# Pool de conexões
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=4
