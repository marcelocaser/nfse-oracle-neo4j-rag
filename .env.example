# Neo4j — valores padrão do docker-compose.yml deste exemplo (npm run infra:up)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Modelo de embeddings, rodado localmente via @huggingface/transformers
# (baixado do Hugging Face no primeiro run)
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# OpenRouter — crie a chave em https://openrouter.ai/keys
OPENROUTER_API_KEY=
# https://openrouter.ai/models?fmt=cards&max_price=0
NLP_MODEL=google/gemma-3-27b-it:free
# Enviados como HTTP-Referer e X-Title nas chamadas ao OpenRouter
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=My Example

# ---------------------------------------------------------------------------
# Oracle 11g — origem dos PDFs (coluna BLOB)
#
# Exige Thick mode com Oracle Instant Client 19.x: o Thin mode do node-oracledb
# só conecta em Oracle Database 12.1+. Veja o README para a instalação.
# ---------------------------------------------------------------------------
ORACLE_USER=
ORACLE_PASSWORD=

# Easy Connect (exige SERVICE_NAME):  host:1521/orclpdb
# Em 11g que só expõe SID, use o descritor TNS completo:
#   (DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=meu-host)(PORT=1521))(CONNECT_DATA=(SID=orcl)))
ORACLE_CONNECT_STRING=

# Só tem efeito em Windows/macOS. No Linux registre as libs via ldconfig (README).
ORACLE_CLIENT_LIB_DIR=
# Pasta com tnsnames.ora / sqlnet.ora, se você usar um alias TNS acima
ORACLE_TNS_ADMIN=

# Tabela e colunas de onde os PDFs são lidos
ORACLE_PDF_TABLE=DOCUMENTOS
ORACLE_PDF_ID_COLUMN=ID
ORACLE_PDF_NAME_COLUMN=NOME
ORACLE_PDF_BLOB_COLUMN=ARQUIVO

# Opcional: sobrescreve a query inteira (para joins/filtros próprios).
# Contrato: retornar as colunas ID, NAME e DATA e usar o bind :maxDocs.
# Ex.: SELECT d.ID AS ID, d.NOME AS NAME, d.ARQUIVO AS DATA FROM DOCUMENTOS d
#        WHERE d.CATEGORIA = 'TENSORES' AND ROWNUM <= :maxDocs
ORACLE_PDF_QUERY=

# Quantos PDFs ingerir por execução
ORACLE_PDF_MAX_DOCS=10

# Pool de conexões
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=4
