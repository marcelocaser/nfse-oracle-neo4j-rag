# Volumes do container Neo4j (docker-compose.yml). São dados de runtime,
# root-owned e com centenas de MB.
neo4j/
import/

# Respostas geradas pelo pipeline. Contêm dados extraídos das notas fiscais
# lidas do Oracle — ou seja, dados reais de clientes. Não versionar.
respostas/

# Perguntas de teste (QUESTIONS_FILE). Costumam citar prestadores reais.
perguntas.txt

node_modules/
.env
